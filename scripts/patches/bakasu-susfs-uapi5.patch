Backport BakaSU 8770c7e324a22895703c4916b8a16520e0b81c79 (kernel + UAPI).
Base: fa8311f632a215b5381ec644627c6198d1e8a13e.
Implements EVENT_SERVICES start/skip semantics, not just its version number.
Source: https://github.com/Baka-SU/BakaSU/commit/8770c7e324a22895703c4916b8a16520e0b81c79
License: GPL-2.0-only for kernel code; GPL-3.0-or-later for shared UAPI.

diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
index 1edc0640..95373100 100644
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -138,6 +138,7 @@ static int do_get_info_legacy(void __user *arg)
 
 static int do_report_event(void __user *arg)
 {
+    static bool services_started = false;
     struct ksu_report_event_cmd cmd;
 
     if (copy_from_user(&cmd, arg, sizeof(cmd))) {
@@ -147,6 +148,9 @@ static int do_report_event(void __user *arg)
     switch (cmd.event) {
     case EVENT_POST_FS_DATA: {
         static bool post_fs_data_lock = false;
+
+        // Reset for emulated soft reboot
+        services_started = false;
         if (!post_fs_data_lock) {
             post_fs_data_lock = true;
             if (ksu_late_loaded) {
@@ -179,6 +183,15 @@ static int do_report_event(void __user *arg)
         on_module_mounted();
         break;
     }
+    case EVENT_SERVICES: {
+        if (services_started) {
+            pr_info("services already started, skipping\n");
+            return 0;
+        }
+        services_started = true;
+        pr_info("services triggered\n");
+        return 1;
+    }
     default:
         break;
     }
diff --git a/uapi/supercall.h b/uapi/supercall.h
index 25ab7976..9ba813dc 100644
--- a/uapi/supercall.h
+++ b/uapi/supercall.h
@@ -17,7 +17,8 @@
 // 2: allowlist v4 root profile flags
 // 3: scoped su-session driver fd
 // 4: add KSU_GET_INFO_FLAG_BUNDLED
-static const __u32 KERNEL_SU_UAPI_VERSION = 4;
+// 5: add EVENT_SERVICES with a start/skip result
+static const __u32 KERNEL_SU_UAPI_VERSION = 5;
 
 /* Magic numbers for reboot hook to install fd */
 DEFINE_KSU_UAPI_CONST(__u32, KSU_INSTALL_MAGIC1, 0xDEADBEEF)
@@ -30,6 +31,7 @@ struct ksu_become_daemon_cmd {
 DEFINE_KSU_UAPI_CONST(__u32, EVENT_POST_FS_DATA, 1)
 DEFINE_KSU_UAPI_CONST(__u32, EVENT_BOOT_COMPLETED, 2)
 DEFINE_KSU_UAPI_CONST(__u32, EVENT_MODULE_MOUNTED, 3)
+DEFINE_KSU_UAPI_CONST(__u32, EVENT_SERVICES, 4)
 
 DEFINE_KSU_UAPI_CONST(__u32, KSU_GET_INFO_FLAG_LKM, (1U << 0))
 DEFINE_KSU_UAPI_CONST(__u32, KSU_GET_INFO_FLAG_MANAGER, (1U << 1))
