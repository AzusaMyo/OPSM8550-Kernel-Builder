+/* Bridge the extension hub to the implementations in the pinned driver.
+ * Availability is config-backed; ksud additionally probes the live KPM
+ * version and SuSFS reboot ABI. Never claim unsupported hub features.
+ */
+static int do_extension(void __user *arg)
+{
+    struct ksu_extension_cmd cmd;
+
+    if (copy_from_user(&cmd, arg, sizeof(cmd)))
+        return -EFAULT;
+    if (cmd.id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+    if (cmd.op != KSU_EXTENSION_GET && cmd.op != KSU_EXTENSION_SET &&
+        cmd.op != KSU_EXTENSION_IO && cmd.op != KSU_EXTENSION_WIPE)
+        return -EINVAL;
+
+    if (cmd.op == KSU_EXTENSION_IO) {
+#ifdef CONFIG_KPM
+        if (cmd.id == KSU_EXTENSION_KPM)
+            return do_kpm((void __user *)(unsigned long)cmd.user_ptr);
+#endif
+        return -EOPNOTSUPP;
+    }
+    /* KPM and SuSFS have no sticky enable bit or wipe operation. */
+    if (cmd.op != KSU_EXTENSION_GET)
+        return -EOPNOTSUPP;
+
+    cmd.supported = 0;
+    cmd.value = 0;
+    cmd.reserved = 0;
+    switch (cmd.id) {
+#ifdef CONFIG_KPM
+    case KSU_EXTENSION_KPM:
+        cmd.supported = KSU_FEATURE_FLAG_SUPPORTED;
+        cmd.value = 1;
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS
+    case KSU_EXTENSION_SUSFS:
+        cmd.supported = KSU_FEATURE_FLAG_SUPPORTED;
+        break;
+#endif
+    default:
+        return -EOPNOTSUPP;
+    }
+    if (copy_to_user(arg, &cmd, sizeof(cmd)))
+        return -EFAULT;
+    return 0;
+}
